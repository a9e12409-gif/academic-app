@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --paper: #f5f6fa;
  --surface: #ffffff;
  --ink: #111827;
  --muted: #6b7280;
  --soft: #9ca3af;
  --line: #e8eaf0;
  --violet: #4f46e5;
  --violet-2: #4338ca;
  --mint: #0f9f75;
  --lav: #eef2ff;
  --green: #ecfdf5;
  --danger: #dc2626;
  --shadow: 0 1px 2px rgba(17, 24, 39, 0.04), 0 8px 24px rgba(17, 24, 39, 0.04);
  --radius: 20px;
  font-family: "IBM Plex Sans Arabic", "Segoe UI", Tahoma, Arial, sans-serif;
  color: var(--ink);
  background: var(--paper);
  font-size: 16px;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
}

* { box-sizing: border-box; }
body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(1200px 420px at 100% -10%, #eef2ff 0%, transparent 55%),
    var(--paper);
}
button, input, select, textarea { font: inherit; }
button { color: inherit; cursor: pointer; }
button:disabled { cursor: default; }
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible,
a:focus-visible {
  outline: 2px solid #818cf8;
  outline-offset: 3px;
}
::selection { background: #e0e7ff; }

.app {
  max-width: 1080px;
  min-height: 100vh;
  margin: auto;
  padding: 0 24px 88px;
  display: flex;
  flex-direction: column;
}

header {
  position: sticky;
  top: 0;
  z-index: 12;
  height: 68px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  background: color-mix(in srgb, var(--paper) 78%, white);
  backdrop-filter: blur(18px);
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  color: var(--ink);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
}
.brand b { color: var(--violet); font-weight: 700; }
.logo {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  background: var(--lav);
  display: grid;
  place-items: center;
  position: relative;
}
.logo i {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--violet);
}
.logo i:nth-child(1) { right: 8px; top: 8px; }
.logo i:nth-child(2) { right: 13px; top: 13px; background: var(--mint); }
.logo i:nth-child(3) { right: 8px; top: 18px; opacity: 0.45; }

.desktop-nav { flex: 1; display: flex; justify-content: center; }
.nav {
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 4px;
  background: #eceef5;
  border-radius: 999px;
}
.nav button {
  border: 0;
  background: transparent;
  border-radius: 999px;
  padding: 8px 16px;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 6px;
}
.nav button.selected {
  background: var(--surface);
  color: var(--ink);
  box-shadow: 0 1px 2px rgba(17, 24, 39, 0.06);
}
.nav small {
  font-size: 11px;
  color: var(--violet);
  background: var(--lav);
  padding: 1px 6px;
  border-radius: 999px;
}

.actions { display: flex; align-items: center; gap: 6px; position: relative; }
.icon-btn {
  height: 40px;
  width: 40px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--muted);
  display: grid;
  place-items: center;
  position: relative;
}
.icon-btn:hover, .icon-btn.on { color: var(--violet); background: var(--lav); }
.icon-btn.on:after {
  content: "";
  position: absolute;
  right: 9px;
  top: 9px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--mint);
}
.upload { cursor: pointer; }
.upload input { display: none; }
.cta {
  height: 40px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0 14px;
  border: 0;
  border-radius: 12px;
  background: var(--violet);
  color: #fff;
  font-size: 13px;
  font-weight: 600;
}
.cta:hover { background: var(--violet-2); }
.menu-btn, .mobile-nav, .tabbar { display: none; }

.more-menu {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;
  z-index: 20;
  min-width: 220px;
  padding: 8px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: var(--shadow);
}
.more-menu button, .more-menu label {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border: 0;
  border-radius: 12px;
  background: transparent;
  color: var(--ink);
  font-size: 14px;
  text-align: right;
  cursor: pointer;
}
.more-menu button:hover, .more-menu label:hover { background: #f3f4f8; }
.more-menu .upload { width: 100%; height: auto; color: var(--ink); border-radius: 12px; }

main { flex: 1; }
.intro {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px;
  padding: 18px 0 14px;
}
.intro h1 {
  font-size: clamp(22px, 2.8vw, 30px);
  line-height: 1.3;
  letter-spacing: -0.04em;
  font-weight: 650;
  margin: 0 0 4px;
}
.intro h1 em { font-style: normal; color: var(--violet); }
.intro p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
.date {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 7px 12px;
  border-radius: 999px;
  background: #eceef5;
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}
.date svg { color: var(--violet); }

.next-card {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin-bottom: 16px;
  padding: 16px 18px;
  border: 0;
  border-radius: var(--radius);
  background: linear-gradient(135deg, #eef2ff 0%, #ffffff 58%);
  text-align: right;
  box-shadow: var(--shadow);
}
.next-card .next-kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--violet);
  margin-bottom: 2px;
}
.next-card strong { display: block; font-size: 17px; }
.next-card > div > span { color: var(--muted); font-size: 13px; }
.next-card .next-time {
  margin-right: auto;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: var(--ink);
  font-size: 20px;
}
.next-card .next-time small {
  font-size: 12px;
  font-weight: 500;
  color: var(--muted);
}

.daybar {
  position: sticky;
  top: 68px;
  z-index: 8;
  margin: 0 -4px;
  padding: 8px 4px 12px;
  background: color-mix(in srgb, var(--paper) 88%, white);
  backdrop-filter: blur(12px);
}
.days {
  display: flex;
  gap: 8px;
  overflow: auto;
  scrollbar-width: none;
}
.days::-webkit-scrollbar { display: none; }
.days button {
  flex: 1;
  min-width: 64px;
  min-height: 64px;
  padding: 8px 6px;
  border: 1px solid transparent;
  border-radius: 16px;
  background: transparent;
  color: var(--muted);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
}
.days button small { font-size: 11px; font-weight: 500; }
.days button b { font-size: 16px; font-weight: 650; color: inherit; }
.days button.day-on {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--line);
  box-shadow: var(--shadow);
}
.days button.day-on b { color: var(--violet); }
.days button i {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--mint);
}

.section-title {
  display: flex;
  align-items: end;
  justify-content: space-between;
  padding: 8px 0 14px;
}
.section-title h2, .vault-head h2 {
  font-size: 17px;
  letter-spacing: -0.03em;
  font-weight: 650;
  margin: 0;
}
.section-title h2 span, .vault-head sup { color: var(--soft); font-weight: 500; }
.legend { display: flex; gap: 14px; color: var(--muted); font-size: 12px; }
.legend span { display: flex; align-items: center; gap: 6px; }
.legend i { width: 8px; height: 8px; border-radius: 50%; background: var(--violet); }
.legend span + span i { background: var(--mint); }

.timeline { position: relative; padding: 0 0 8px; }
.timeline:before {
  content: "";
  position: absolute;
  right: 11px;
  top: 28px;
  bottom: 20px;
  width: 2px;
  background: #e5e7f0;
  border-radius: 99px;
}
.station {
  position: relative;
  display: grid;
  grid-template-columns: 24px 1fr;
  column-gap: 14px;
  padding-bottom: 10px;
}
.node {
  position: relative;
  z-index: 1;
  width: 14px;
  height: 14px;
  margin: 24px 5px 0;
  border: 2.5px solid var(--violet);
  border-radius: 50%;
  background: var(--paper);
}
.node.mint { border-color: var(--mint); }
.live .node { box-shadow: 0 0 0 6px #4f46e51a; background: var(--violet); }
.live .node.mint { box-shadow: 0 0 0 6px #0f9f751a; background: var(--mint); }

.station-head {
  grid-column: 2;
  width: 100%;
  display: grid;
  grid-template-columns: 68px 1fr 20px;
  gap: 12px;
  align-items: start;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  text-align: right;
}
.live .station-head { border-color: #c7d2fe; background: #fafafe; }
.time {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  color: var(--soft);
  font-size: 12px;
  font-variant-numeric: tabular-nums;
}
.time b { font-size: 16px; color: var(--ink); font-weight: 650; }
.station-info { min-width: 0; }
.title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; min-height: 24px; }
.title strong { font-size: 16px; font-weight: 650; letter-spacing: -0.02em; }
.title small {
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--lav);
  color: var(--violet-2);
  font-size: 12px;
  font-weight: 600;
}
.title small.mint-tag { background: var(--green); color: #047857; }
.title em { color: var(--violet); font-style: normal; font-size: 12px; font-weight: 600; }
.room { display: flex; align-items: center; gap: 4px; margin-top: 6px; color: var(--muted); font-size: 13px; }
.station-head > svg { color: var(--soft); transition: transform 0.2s; margin-top: 4px; }
.rot { transform: rotate(180deg); }
.progress { display: block; height: 4px; max-width: 280px; margin-top: 10px; background: #e0e7ff; border-radius: 99px; overflow: hidden; }
.progress i { display: block; height: 100%; background: var(--violet); }
.remaining { display: block; margin-top: 6px; color: var(--violet); font-size: 12px; }

.station-drawer {
  grid-column: 2;
  margin-top: -6px;
  padding: 4px 16px 16px;
  border: 1px solid var(--line);
  border-top: 0;
  border-radius: 0 0 var(--radius) var(--radius);
  background: var(--surface);
  animation: appear 0.2s;
}
.station:has(.station-drawer) .station-head { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.att-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 0;
  color: var(--muted);
  font-size: 13px;
}
.att-row span:last-child {
  display: flex;
  gap: 0;
  padding: 3px;
  background: #f3f4f8;
  border-radius: 999px;
}
.att-row button {
  min-height: 34px;
  padding: 0 14px;
  border: 0;
  border-radius: 999px;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-weight: 600;
}
.att-row button.present { background: var(--green); color: #047857; }
.att-row button.absent { background: #fef2f2; color: var(--danger); }
.station-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.quick-task {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
  min-width: 180px;
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8f9fc;
}
.quick-task input {
  min-width: 0;
  flex: 1;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 13px;
  outline: none;
}
.quick-task button { border: 0; background: transparent; color: var(--violet); font-size: 13px; font-weight: 600; }
.quick-task button:disabled { display: none; }
.plain {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 0 8px;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
  font-weight: 500;
}
.plain:hover { color: var(--violet); }
.remove {
  height: 36px;
  width: 36px;
  display: grid;
  place-items: center;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: var(--soft);
}
.remove:hover { background: #fef2f2; color: var(--danger); }
.gap {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 2px 0 12px 0;
  margin-right: 38px;
  color: var(--soft);
  font-size: 12px;
}
.gap i { width: 24px; border-top: 1px dashed #d1d5db; }
.gap i:last-child { flex: 1; }
.more-add {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 4px 38px 0 0;
  min-height: 40px;
  border: 0;
  background: transparent;
  color: var(--muted);
  font-size: 13px;
}
.more-add svg {
  width: 22px;
  height: 22px;
  padding: 3px;
  border: 1px dashed #c7cdd8;
  border-radius: 50%;
}
.footnote {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 8px 0 0;
  padding: 8px 0 4px;
  color: var(--soft);
  font-size: 12px;
}

.empty {
  min-height: 260px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 36px 16px;
  border: 1px dashed var(--line);
  border-radius: 24px;
  background: color-mix(in srgb, var(--surface) 70%, transparent);
}
.empty-icon {
  width: 52px;
  height: 52px;
  display: grid;
  place-items: center;
  border-radius: 16px;
  background: var(--lav);
  color: var(--violet);
  margin-bottom: 14px;
}
.empty-icon svg { width: 22px; }
.empty h3 { margin: 0 0 6px; font-size: 18px; font-weight: 650; }
.empty p { max-width: 340px; margin: 0 0 16px; color: var(--muted); font-size: 14px; line-height: 1.8; }
.primary {
  min-height: 44px;
  display: inline-flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  padding: 0 18px;
  border: 0;
  border-radius: 14px;
  background: var(--violet);
  color: white;
  font-size: 14px;
  font-weight: 600;
}
.primary:hover { background: var(--violet-2); }

.vault-head { padding: 4px 0 12px; }
.workspace {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 20px;
  align-items: start;
}
.course-grid {
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.course-tile {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 48px;
  padding: 8px 10px;
  border: 1px solid transparent;
  border-radius: 14px;
  background: transparent;
  text-align: right;
  color: var(--muted);
  font-size: 14px;
  font-weight: 500;
}
.course-tile:hover { background: #eceef5; }
.course-tile.course-selected {
  background: var(--surface);
  color: var(--ink);
  border-color: var(--line);
  box-shadow: var(--shadow);
}
.course-icon {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 10px;
  background: var(--lav);
  color: var(--violet-2);
}
.course-icon.c1 { background: var(--green); color: #047857; }
.course-icon.c2 { background: #fff7ed; color: #c2410c; }
.course-detail {
  padding: 4px 0 0;
  animation: appear 0.2s;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: 18px 18px 12px;
}
.course-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 0 0 16px;
}
.course-head h2 { margin: 4px 0 0; font-size: 22px; font-weight: 650; letter-spacing: -0.03em; }
.course-head small { color: var(--soft); font-size: 12px; font-weight: 600; }
.course-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
.absence {
  height: 40px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8f9fc;
  color: var(--muted);
  font-size: 13px;
}
.absence i { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); }
.absence input { width: 28px; border: 0; background: transparent; text-align: center; font-size: 13px; color: inherit; }
.absence.warn { border-color: #fecaca; background: #fff7f7; color: var(--danger); }
.absence.warn i { background: #ef4444; }
.whatsapp {
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 40px;
  padding: 0 14px;
  border: 0;
  border-radius: 12px;
  background: var(--mint);
  color: white;
  font-size: 13px;
  font-weight: 600;
}
.whatsapp:hover { background: #0d8a65; }
.edit-link { border: 0; background: transparent; color: var(--muted); font-size: 13px; min-height: 40px; }
.list-head { display: flex; justify-content: space-between; padding: 8px 2px 10px; }
.list-head b { font-size: 14px; }
.list-head span { font-size: 13px; color: var(--soft); }
.course-session { margin-bottom: 8px; }
.session-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #fafbfe;
  text-align: right;
  color: var(--ink);
}
.session-toggle > i { width: 8px; height: 8px; border-radius: 50%; background: var(--violet); }
.session-toggle > i.mint { background: var(--mint); }
.session-toggle > span { flex: 1; font-size: 14px; font-weight: 600; }
.session-toggle span small { margin-right: 8px; color: var(--muted); font-size: 13px; font-weight: 500; }
.session-toggle em { color: var(--muted); font-style: normal; font-size: 13px; }
.session-toggle > svg { color: var(--soft); transition: transform 0.2s; }
.course-session:has(.session-tools) .session-toggle {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  border-bottom-color: transparent;
  background: var(--surface);
}
.session-tools {
  padding: 4px 16px 16px;
  border: 1px solid var(--line);
  border-top: 0;
  border-radius: 0 0 16px 16px;
  background: var(--surface);
  animation: appear 0.2s;
}
.tool-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 12px 0 8px;
}
.tool-row > b {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--ink);
  font-size: 14px;
  font-weight: 600;
}
.tool-row > b svg { color: var(--violet); }
.outline {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid #c7d2fe;
  border-radius: 999px;
  color: var(--violet-2);
  font-size: 13px;
  font-weight: 600;
  overflow: hidden;
  cursor: pointer;
}
.outline input { position: absolute; inset: 0; opacity: 0; cursor: pointer; }
.hint { display: flex; align-items: center; gap: 6px; margin: 4px 0 8px; color: var(--soft); font-size: 13px; }
.file-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 0;
  border-bottom: 1px solid #f1f2f6;
}
.file-row > button:first-child {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 14px;
  text-align: right;
}
.video-input, .tasks form {
  display: flex;
  align-items: center;
  width: min(420px, 100%);
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8f9fc;
  padding: 0 8px 0 4px;
}
.video-input input, .tasks form input {
  min-width: 0;
  flex: 1;
  padding: 10px 8px;
  border: 0;
  background: transparent;
  color: var(--ink);
  font-size: 14px;
  outline: none;
}
.video-input button, .tasks form button {
  display: grid;
  place-items: center;
  width: 36px;
  height: 36px;
  border: 0;
  background: transparent;
  color: var(--violet);
}
.video-input button:disabled, .tasks form button:disabled { color: #c5c0c8; }
.tasks { border-top: 1px solid #f1f2f6; margin-top: 6px; }
.task {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 8px 0;
  color: var(--ink);
  font-size: 14px;
}
.task span { flex: 1; }
.task.done span { text-decoration: line-through; color: var(--soft); }
.check {
  width: 20px;
  height: 20px;
  padding: 0;
  display: grid;
  place-items: center;
  border: 1.5px solid #d1d5db;
  border-radius: 6px;
  background: transparent;
  color: white;
}
.done .check { border-color: var(--mint); background: var(--mint); }
.session-tools textarea {
  display: block;
  width: 100%;
  resize: vertical;
  padding: 10px 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8f9fc;
  color: var(--ink);
  font-size: 14px;
  line-height: 1.8;
  outline: none;
}
.no-sessions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 16px;
  border: 1px dashed var(--line);
  border-radius: 16px;
  color: var(--muted);
  font-size: 14px;
}

.exam-line { display: flex; flex-direction: column; gap: 10px; padding: 4px 0 12px; }
.exam-row {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 12px;
  min-height: 80px;
  padding: 16px 18px;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  cursor: pointer;
}
.exam-row:hover { border-color: #c7d2fe; }
.exam-row > i { display: none; }
.exam-date { display: flex; flex-direction: column; gap: 2px; color: var(--muted); font-size: 12px; min-width: 72px; }
.exam-date b { font-size: 15px; color: var(--ink); }
.exam-info > span { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.exam-info > span b { font-size: 16px; }
.exam-info > span small {
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--lav);
  color: var(--violet-2);
  font-size: 12px;
  font-weight: 600;
}
.exam-info p { display: flex; gap: 12px; margin: 6px 0 0; color: var(--muted); font-size: 13px; }
.exam-info p span { display: flex; align-items: center; gap: 4px; }
.countdown {
  padding: 6px 10px;
  border-radius: 999px;
  background: #eceef5;
  color: var(--ink);
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 0 20px;
  color: var(--soft);
  font-size: 12px;
}
footer i { color: var(--violet); font-style: normal; }

.toast {
  position: fixed;
  z-index: 30;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 16px;
  border-radius: 999px;
  background: #111827;
  color: white;
  box-shadow: 0 12px 35px rgba(17, 24, 39, 0.22);
  font-size: 14px;
  white-space: nowrap;
  animation: appear 0.2s;
}
.toast svg { color: #6ee7b7; }

.scrim {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: grid;
  place-items: center;
  padding: 18px;
  background: rgba(17, 24, 39, 0.36);
  backdrop-filter: blur(8px);
}
.modal {
  width: min(100%, 460px);
  max-height: 90vh;
  overflow: auto;
  padding: 22px 22px 24px;
  border-radius: 24px;
  background: var(--surface);
  box-shadow: 0 25px 80px rgba(17, 24, 39, 0.18);
  animation: appear 0.2s;
}
.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 14px;
  margin-bottom: 16px;
  border-bottom: 1px solid var(--line);
}
.modal-head small { display: none; }
.modal-head h2 { margin: 4px 0 0; font-size: 20px; font-weight: 650; }
.form { display: flex; flex-direction: column; gap: 14px; }
.form label { display: flex; flex-direction: column; gap: 6px; color: var(--muted); font-size: 13px; font-weight: 500; }
.form label small { color: var(--soft); font-size: 12px; }
.form input, .form select {
  height: 44px;
  width: 100%;
  padding: 0 12px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: #f8f9fc;
  color: var(--ink);
  font-size: 15px;
  outline: none;
}
.form input:focus, .form select:focus {
  border-color: #a5b4fc;
  box-shadow: 0 0 0 4px #4f46e514;
  background: #fff;
}
.form input[type="time"], .form input[type="date"] { direction: ltr; text-align: left; }
.form-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.form > .hint { margin: 0; }
.form > .primary { width: 100%; margin-top: 2px; }

@keyframes appear {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 860px) {
  .app { padding: 0 16px 96px; }
  header { height: 60px; }
  .desktop-nav { display: none; }
  .tabbar {
    display: flex;
    position: fixed;
    z-index: 15;
    right: 12px;
    left: 12px;
    bottom: 12px;
    padding: 6px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--surface) 92%, white);
    border: 1px solid var(--line);
    box-shadow: 0 12px 40px rgba(17, 24, 39, 0.1);
    backdrop-filter: blur(16px);
  }
  .tabbar .nav {
    width: 100%;
    background: transparent;
    padding: 0;
    gap: 4px;
  }
  .tabbar button {
    flex: 1;
    min-height: 48px;
    border: 0;
    border-radius: 14px;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    font-weight: 600;
    box-shadow: none;
    justify-content: center;
  }
  .tabbar button.selected { background: var(--lav); color: var(--violet); }
  .intro { padding: 14px 0 12px; align-items: flex-start; }
  .daybar { top: 60px; }
  .workspace { grid-template-columns: 1fr; }
  .course-grid {
    flex-direction: row;
    overflow: auto;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .course-tile { flex: 0 0 auto; max-width: 220px; }
  .course-head { flex-direction: column; }
  .course-actions { justify-content: flex-start; }
  .exam-row { grid-template-columns: 1fr auto; }
  .exam-row > .plain { display: none; }
  .cta-label { display: none; }
  .cta { width: 40px; padding: 0; justify-content: center; }
  .toast { bottom: 84px; }
}

@media (max-width: 520px) {
  .intro { flex-direction: column; gap: 10px; }
  .station-head { grid-template-columns: 54px 1fr 18px; padding: 12px; }
  .form-pair { grid-template-columns: 1fr; }
  .exam-row { grid-template-columns: 1fr; }
  footer { flex-direction: column; gap: 4px; }
}

@media (prefers-reduced-motion: reduce) {
  *, *:before, *:after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}
